# Trade Compass Agent — local settings template
# 本地配置模板：复制为 .env 后填入密钥（Copy to .env and fill in secrets）
#
#   cp .env.example .env

# ── Paths / profile ──────────────────────────────────────────────────────────
# 数据目录 | Local data cache (bars, portfolio, audit)
TRADE_COMPASS_DATA_DIR=./data
# 记忆库目录 | Markdown memory vault (rulebooks, reviews, tree/)
TRADE_COMPASS_MEMORY_DIR=./memory_vault
# 配置 profile | Matches config/default.yaml profile key
TRADE_COMPASS_PROFILE=local

# ── Server (optional) ────────────────────────────────────────────────────────
# API 端口 | Default 19704; override --port or this env
# TRADE_COMPASS_PORT=19704
# 最大 HTTP 请求体（字节）| Default 10 MiB
# TRADE_COMPASS_MAX_REQUEST_BYTES=10485760
# 开发 CORS | Set 1 when Vite dev (:3000) talks to API (:19704)
# Also set automatically by `trade-compass serve --dev`
TRADE_COMPASS_DEV_CORS=

# ── Data providers (optional) ────────────────────────────────────────────────
# Tushare token — requires pip install -e ".[tushare]" and data.tushare_enabled: true
TUSHARE_TOKEN=

# 网络代理 | Network proxy — domestic finance APIs (eastmoney/sina) often fail through proxy
# 建议关闭系统代理，或设置 NO_PROXY 绕过：
# NO_PROXY=localhost,127.0.0.1,eastmoney.com,.eastmoney.com,push2.eastmoney.com,datacenter-web.eastmoney.com,sina.com.cn,.sina.com.cn

# ── LLM providers (optional) ─────────────────────────────────────────────────
# Default in config/default.yaml: provider deepseek, model deepseek-chat
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=

# ── Vision (image attachment support) ────────────────────────────────────────
# DeepSeek is text-only; to enable image understanding, configure a vision model.
# Option A: Use OpenAI (requires OPENAI_API_KEY above)
#   In config/default.yaml set:  vision_model: gpt-4o-mini
#                                 vision_provider: openai
#                                 vision_api_key_env: OPENAI_API_KEY
# Option B: Use DashScope (Qwen-VL)
#   DASHSCOPE_API_KEY=
#   In config/default.yaml set:  vision_model: qwen-vl-max
#                                 vision_provider: dashscope
#                                 vision_api_key_env: DASHSCOPE_API_KEY

# ── MCP (optional) ───────────────────────────────────────────────────────────
# MCP server tokens — keep secrets in gitignored .trade-compass/mcp.json (not in repo).
# Use ${VAR_NAME} in mcp.json url/headers to reference env vars defined here.
# EXAMPLE_API_TOKEN=

# ── Kronos K-line Forecast (optional) ────────────────────────────────────────
# Path to cloned Kronos repo — required for kline_forecast tool
# Install: pip install -e ".[forecast]" && git clone https://github.com/NeoQuasar/Kronos.git
KRONOS_PATH=

# ── Search (optional) ────────────────────────────────────────────────────────
# Tavily API key for enhanced web search — get one at https://tavily.com
TAVILY_API_KEY=
# xAI API key for X (Twitter) search via Grok — get one at https://console.x.ai
XAI_API_KEY=

# ── Notification channels (optional) ────────────────────────────────────────
# 飞书群 Webhook 推送 | Feishu group bot webhook (push-only)
FEISHU_WEBHOOK_URL=
FEISHU_WEBHOOK_SECRET=
# 飞书应用 Bot 双向 | Feishu app bot (bidirectional, requires lark_oapi)
FEISHU_APP_ID=
FEISHU_APP_SECRET=
# 主动推送目标会话（可选，oc_ 开头的 chat_id；不设则需先给 Bot 发一条消息）
FEISHU_PUSH_CHAT_ID=
# 企微群 Webhook 推送 | WeCom group robot webhook (push-only)
WECOM_WEBHOOK_URL=
# 企微应用 Bot 双向 | WeCom app bot (bidirectional)
WECOM_CORP_ID=
WECOM_AGENT_SECRET=
WECOM_AGENT_ID=
# 通用 Webhook | Generic webhook (any URL that accepts POST JSON)
WEBHOOK_NOTIFICATION_URL=

# ── Logging ───────────────────────────────────────────────────────────────────
# 日志级别 | DEBUG, INFO (default), WARNING, ERROR
LOG_LEVEL=INFO
# 日志格式 | "json" for structured JSON lines, empty for colored console
LOG_FORMAT=
# 模块级别覆盖 | Per-module override (e.g. LOG_LEVEL_SCREENING=DEBUG)
# LOG_LEVEL_OPS=DEBUG
# LOG_LEVEL_RUNTIME=DEBUG

# ── Privacy ──────────────────────────────────────────────────────────────────
# 隐私门控 | Allow memory/review snippets in external LLM calls (learning curator)
ALLOW_EXTERNAL_LLM_MEMORY=false
