{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "trade-compass-agent.specialists.screener.report.v1",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "signals",
    "warnings",
    "metadata"
  ],
  "properties": {
    "signals": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "specialist_id",
        "execution_model"
      ],
      "properties": {
        "specialist_id": {
          "const": "screener"
        },
        "execution_model": {
          "const": "single_agent_react"
        }
      }
    }
  }
}
