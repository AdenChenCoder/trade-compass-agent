{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "trade-compass-agent.workflows.intraday_tech.v2.output",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "workflow_id",
    "workflow_version",
    "run_id",
    "artifact_id",
    "created_at",
    "schema_version",
    "inputs_hash",
    "source_refs",
    "evaluation_status",
    "as_of",
    "warnings",
    "no_trade_disclaimer"
  ],
  "properties": {
    "workflow_id": {
      "const": "intraday_tech"
    },
    "workflow_version": {
      "const": 2
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "artifact_id": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "minLength": 1
    },
    "schema_version": {
      "const": 2
    },
    "inputs_hash": {
      "type": "string",
      "minLength": 1
    },
    "source_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evaluation_status": {
      "type": "string"
    },
    "as_of": {
      "type": "string"
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "no_trade_disclaimer": {
      "const": true
    }
  }
}
