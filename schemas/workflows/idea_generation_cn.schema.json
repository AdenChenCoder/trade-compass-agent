{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "trade-compass/idea_generation_cn",
  "type": "object",
  "required": ["workflow_id", "workflow_version", "run_id", "artifact_id", "created_at", "as_of", "schema_version", "inputs_hash", "source_refs", "ideas", "warnings", "evaluation_status", "no_trade_disclaimer"],
  "additionalProperties": false,
  "properties": {
    "workflow_id": {"type": "string", "enum": ["idea_generation_cn"]},
    "workflow_version": {"type": "integer", "minimum": 1},
    "run_id": {"type": "string", "maxLength": 128},
    "artifact_id": {"type": "string", "maxLength": 128},
    "created_at": {"type": "string", "minLength": 1, "maxLength": 64},
    "schema_version": {"type": "integer", "minimum": 1},
    "inputs_hash": {"type": "string", "minLength": 1, "maxLength": 128},
    "source_refs": {"type": "array", "items": {"type": "string", "maxLength": 1000}},
    "evaluation_status": {"type": "string", "minLength": 1, "maxLength": 64},
    "as_of": {"type": "string", "minLength": 1, "maxLength": 32},
    "primary_step_id": {"type": "string", "maxLength": 80},
    "mode": {"type": "string", "enum": ["morning", "weekend", "weekly", "manual"]},
    "context": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "market_pulse": {"type": "object"},
        "risk_constraints": {"type": "object"},
        "sector_boards": {},
        "concept_boards": {},
        "hot_stocks": {},
        "fund_flow": {},
        "fundamentals": {"type": "object"},
        "technical_indicators": {"type": "object"},
        "prior_ideas": {"type": "object"}
      }
    },
    "ideas": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["idea_id", "symbol", "direction", "score", "drivers", "risks", "next_step", "no_trade_disclaimer"],
        "additionalProperties": false,
        "properties": {
          "idea_id": {"type": "string", "minLength": 1, "maxLength": 80},
          "as_of": {"type": "string", "minLength": 1, "maxLength": 32},
          "symbol": {"type": "string", "minLength": 1, "maxLength": 16},
          "name": {"type": "string", "maxLength": 80},
          "sector": {"type": "string", "maxLength": 80},
          "theme": {"type": "string", "maxLength": 120},
          "direction": {"type": "string", "enum": ["watch", "research", "avoid", "risk_check"]},
          "score": {"type": "integer", "minimum": 0, "maximum": 100},
          "score_components": {"type": "object"},
          "drivers": {"type": "array", "minItems": 1, "items": {"type": "string", "maxLength": 300}},
          "risks": {"type": "array", "items": {"type": "string", "maxLength": 300}},
          "invalidation_conditions": {"type": "array", "items": {"type": "string", "maxLength": 300}},
          "next_step": {"type": "string", "minLength": 1, "maxLength": 300},
          "related_catalyst_ids": {"type": "array", "items": {"type": "string", "maxLength": 80}},
          "related_prior_idea_ids": {"type": "array", "items": {"type": "string", "maxLength": 80}},
          "source_refs": {"type": "array", "items": {"type": "string", "maxLength": 256}},
          "no_trade_disclaimer": {"type": "boolean"}
        }
      }
    },
    "warnings": {"type": "array", "items": {"type": "string", "maxLength": 300}},
    "no_trade_disclaimer": {"const": true},
    "degraded": {"type": "boolean"}
  }
}
