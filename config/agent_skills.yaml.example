# Agent skills configuration
#
# Copy to config/agent_skills.yaml to customize built-in skill filtering.
# If this file is absent, or enabled_skills is unset, all built-in skills are
# enabled. Runtime-created memory_vault/skills/*/SKILL.md entries are always
# discoverable and override a same-named built-in skill.
#
# enabled_skills: optional allow-list of skill folder names
# default_summaries: optional map of skill name → short summary override for bootstrap
# pinned: optional list always injected first in context (subset of enabled)

# enabled_skills:
#   - intraday-tech
#   - equity-research
#   - a-share-compliance

# default_summaries:
#   intraday-tech: "Short-term TA workflow for A-share intraday structure."
#   equity-research: "Mid-term bull/bear research and trade thesis."

# pinned:
#   - a-share-compliance
